# ─────────────────────────────────────────────────────────────────────────────
# ByteSized Careers Waitlist — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# This project is fully functional today WITHOUT any email provider or domain.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Connection string for a SEPARATE Neon Postgres project (never the CreatorJobs DB).
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# Use node-postgres for local Docker. Leave unset in production for Neon HTTP.
DB_DRIVER=node-postgres

# ── Security secrets (required) ──────────────────────────────────────────────
# Server-only pepper hashed into resume tokens. Generate: openssl rand -base64 32
RESUME_TOKEN_SECRET=
# Server-only pepper hashed into rate-limit IP buckets (raw IPs are never stored).
RATE_LIMIT_IP_PEPPER=

# ── Admin auth: Auth.js (NextAuth v5) + GitHub OAuth (required for /admin) ────
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
# Create a GitHub OAuth app: https://github.com/settings/developers
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub usernames allowed into the admin dashboard, e.g. "guhanp09"
ADMIN_ALLOWED_GITHUB_LOGINS=
# Development-only dashboard preview; false by default and local-host restricted.
ADMIN_LOCAL_PREVIEW_ENABLED=false

# ── Email feature flags (keep false until a domain + provider are configured) ─
EMAIL_DELIVERY_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false

# Local deterministic OTP display. Development/test only; production hard-disables it.
LOCAL_VERIFICATION_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Resend — read only when delivery + verification are enabled. Never commit a real key.
# Configure the updates.bytesizedcareers.com sending subdomain first.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=ByteSized Careers <verify@updates.bytesizedcareers.com>
EMAIL_REPLY_TO=
